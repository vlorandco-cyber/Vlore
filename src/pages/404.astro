---
import Base from '../layouts/Base.astro';
import { pages } from '../lib/site';
---
<Base
  path="/404"
  title="Page not found | VLORE"
  description="This page doesn't exist. Find VLORE's web design, web development and marketing services from here."
  noindex
  page="inner"
  ctaHref="/contact"
>
<main class="over" style="box-shadow:none">
<section class="sec dark on-dark" data-nav="dark" style="min-height:100vh;display:flex;align-items:center">
<div class="wrap">
<div class="sec-head center">
<span class="eyebrow">Error 404</span>
<h1 class="h2">This page has <em>moved on.</em></h1>
<p class="lede">The link may be old or mistyped. Everything VLORE offers is one click away.</p>
</div>
<div class="btns" style="justify-content:center;margin-top:40px">
{pages.map((p) => <a class={p.path === '/contact' ? 'btn btn-beige' : 'btn btn-ghost'} href={p.path}>{p.name}</a>)}
</div>
</div>
</section>
</main>
</Base>
