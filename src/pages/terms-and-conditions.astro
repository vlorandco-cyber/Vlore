---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';

const contents: [string, string][] = [
  ['overview', 'Overview'],
  ['use', 'Using our website'],
  ['ip', 'Intellectual property'],
  ['projects', 'Inquiries and paid projects'],
  ['results', 'No guaranteed results'],
  ['links', 'Third-party links'],
  ['disclaimer', 'Disclaimer'],
  ['liability', 'Limitation of liability'],
  ['law', 'Governing law'],
  ['changes', 'Changes to these terms'],
  ['contact', 'Contact'],
];
---
<Base
  path="/terms-and-conditions"
  title="Terms & Conditions | VLORE"
  description="The terms for using the VLORE website, including intellectual property, third-party links, disclaimers and the separate agreement that governs paid projects."
  breadcrumb={[{ name: 'Terms & Conditions', path: '/terms-and-conditions' }]}
  page="inner"
  ctaHref="/contact"
>
  <link slot="head" rel="stylesheet" href="/styles/legal.css"/>
<LegalPage title="Terms & Conditions" updated="November 18, 2026" contents={contents}>

