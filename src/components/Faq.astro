---
// Visible questions and their FAQPage structured data, from one list, so what search engines
// and AI assistants read is exactly what visitors see.
import { absolute } from '../lib/site';

export interface QA {
  q: string;
  /** Answer HTML; may contain links to other pages. */
  a: string;
}
interface Props {
  items: QA[];
  /** Page path, for the FAQPage's @id. */
  path: string;
  eyebrow?: string;
  /** Heading HTML; <em> renders in the accent colour. */
  heading?: string;
  id?: string;
  /** Extra section classes, e.g. "oak" for the beige background. */
  tone?: string;
}

const { items, path, eyebrow = 'Questions', heading = 'Good to <em>know.</em>', id = 'faq', tone = '' } = Astro.props;
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&rsquo;|&#8217;/g, '’');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${absolute(path)}#faq`,
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: text(i.a) },
  })),
};
---
<section class={`sec ${tone}`.trim()} id={id} data-nav="light">
<div class="wrap">
<div class="sec-head center">
<span class="eyebrow rv">{eyebrow}</span>
<h2 class="h2 split" set:html={heading}></h2>
</div>
<div class="faq rv d1">
{items.map((i) => (
<details><summary>{i.q}</summary><p set:html={i.a}></p></details>
))}
</div>
</div>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</section>
